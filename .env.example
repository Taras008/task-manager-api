# Скопіюйте в .env і змініть секрети. У docker compose хост БД — `db`.
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
# Для локального запуску поза Docker: postgresql+asyncpg://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app_test

# dev | test | prod. У prod JWT_SECRET обов'язковий: унікальний, >= 32 символи.
ENVIRONMENT=dev

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OVERDUE_INTERVAL_SECONDS=60
